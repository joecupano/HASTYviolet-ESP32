//Send LoRa message
void startQUACKING(String HASheader, String LORAmessage, int LORAinterval )
{
  //LoRa.enableCrc();
  String mymessage = HASheader + LORAmessage;
  LoRa.beginPacket();                        // start packet
  //LoRa.print(HASheader);
  //LoRa.write(destinationLORA);               // add destination LoRaaddress
  //LoRa.write(localaddressLORA);              // add sender LoRa address
  //LoRa.write(LORAmessage.length());          // add payload length
  LoRa.print(mymessage);
  //LoRa.print(LORAmessage);                   // add payload
  LoRa.endPacket();                          // finish packet and send it
  //OLEDme("Sending ...",1000);
  Serial.print(millis());
  Serial.print("::Sending LoRa::");
  Serial.println(mymessage);
  //Serial.println(LORAmessage);
  Serial.println(" ");
  delay (LORAinterval);                      // seconds
 }

//Receive LoRa Message
void receiveLORA(int packetSize)
{
  // received a packet
  Serial.print("210: Received LoRa packet '");
  if (packetSize == 0) return;               // if there's no packet, return
  // read packet header bytes:
  int recipient = LoRa.read();               // recipient address
  byte sender = LoRa.read();                 // sender address
  byte incomingMsgId = LoRa.read();          // incoming msg ID
  byte incomingLength = LoRa.read();         // incoming msg length
  String incoming = "";                      // payload of packet
  while (LoRa.available())                   // can't use readString() in callback
  {
    incoming += (char)LoRa.read();           // add bytes one by one
  }
  if (incomingLength != incoming.length())   // check length for error
  {
    Serial.println("error: message length does not match length");
    return;                                  // skip rest of function
  }
  lastmsgrx = incoming;                     // Save as last rx message
  OLEDme(incoming, 1000);
  Serial.println();
  Serial.println("Received from: 0x" + String(sender, HEX));
  Serial.println("Received from: 0x" + String(sender, HEX));
  Serial.println("Sent to: 0x" + String(recipient, HEX));
  Serial.println("Message ID: " + String(incomingMsgId));
  Serial.println("Message length: " + String(incomingLength));
  Serial.println("Message: " + incoming);
  Serial.println("RSSI: " + String(LoRa.packetRssi()));
  Serial.println("Snr: " + String(LoRa.packetSnr()));
  Serial.println();
}

String processor(String var)
{
  if(var == "frequency")
    return String (frequency);
  if(var == "txpwr")
    return String (txpwr);
  if(var == "mycall")
    return mycall;
  if(var == "myssid")
    return myssid;
  if(var == "dstcall")
    return dstcall;
  if(var == "dstssid")
    return dstssid;
  if(var == "message")
    return lastmsgtx;
  return String("unknown");
}



//
// SETUP
//
void setup()
{
  initSerial();
  initSPIFFS();
  getHASVCFG();
  initWiFiCL();
  initWebServer();

  // Start OLED
  Heltec.display->init();
  Heltec.display->flipScreenVertically();  
  Heltec.display->setFont(ArialMT_Plain_10);  
  Heltec.begin(true /*DisplayEnable Enable*/, true /*Heltec.LoRa Disable*/, true /*Serial Enable*/, true /*PABOOST Enable*/, BAND /*long BAND*/);
  Serial.println("500: ESP32 ready...");
  
  // Initialize LoRa
  //
  //LoRa.onReceive(receiveLORA);
  //LoRa.receive();
  LoRa.setFrequency(frequency);
  LoRa.setSignalBandwidth(bandwidth);
  LoRa.setCodingRate4(codingrate4);
  LoRa.setSpreadingFactor(spread);
  LoRa.setTxPower(txpwr,RF_PACONFIG_PASELECT_PABOOST);
  Serial.println("600: LoRa initialized..."); 


  // Reached this point then all is well - Display HVDN Logo on OLED
  logo();
  Serial.println("700: HVDN Logo displayed (OLED)...");
  Serial.println("===============================");
  Serial.print("999: HASviolet is awake and available at ");
  Serial.print(" on SSID: ");
  Serial.println(CLssid);
  Serial.println();
}

// 
// MAIN LOOP
//

void loop(){
  LoRa.onReceive(receiveLORA);
  LoRa.receive();
}
