//
// VARIABLES
//

// Set WiFi AP
const char* CLssid = "Excelsior";            // SSID of WiFi this Node will be client of
const char* CLpassword = "19144966520";      // Password of WiFi this Node will be client of

// Set WebAuthh
const char* wwwUSERNAME = "admin";           // Webpage Login
const char* wwwAUTHPASS = "Quackers";        // Webpage password

// Configure LoRa and Appstack
byte localaddressLORA = 0xBB;                // LoRa address of this device (irrelevant)
byte destinationLORA = 0xFF;                 // LoRa destination to send to (broadcast default)
String mycall = "NOCALL";
String myssid = "00";
String dstcall = "BEACON";                   // HASviolet Destination Call ( BEACON )
String dstssid = "99";                       // HASviolet Desnitation Call ( 99 )
String mybeacon = "QRZ?";                    // HASviolet Desnitation Call ( 99 )
String lastmsgrx = "None";                   // Last received message
String lastmsgtx = "None";                   // Last transmitted message
int frequency = 911250000;                   // HASviolet default settings for safe LoRa module init
int bandwidth = 312500;
int spread = 7;
int codingrate4 = 8;
int txpwr = 5;

// Create AsyncWebServer object on port 80
AsyncWebServer server(8000);
AsyncWebSocket ws("/ws");


//
// FUNCTIONS
//

// Websocket action
void onWsEvent(AsyncWebSocket * server, AsyncWebSocketClient * client, AwsEventType type, void * arg, uint8_t *data, size_t len){
 
  if(type == WS_EVT_CONNECT){
 
    Serial.println("ACK:CONNECT");
    client->text("ACK:CONNECT");
 
  } else if(type == WS_EVT_DISCONNECT){
    Serial.println("Client disconnected");
 
  }
}

/// SETUP FUNCTIONS
void initSerial() {
  // Serial port for debugging purposes
  Serial.begin(115200);
  Serial.println();
  Serial.println();
  Serial.println("000: HASviolet ESP32");
  Serial.println("===============================");
}

void initSPIFFS() {
  // Initialize SPIFFS
  if(!SPIFFS.begin(true)){
    Serial.println("ERR: SPIFFS mounting");
    return;
  }
  Serial.println("100: SPIFFs initialized...");
}

void initWiFiCL() {
  // Initialize WiFi AP
  WiFi.begin(CLssid, CLpassword);
  while(WiFi.status() != WL_CONNECTED) { 
    delay(500);
    Serial.print(".");
  }
  Serial.println("300: WiFi MAC " + WiFi.macAddress());
  Serial.println("305: WiFi CL initialized... ");
}

void initWebServer() {
  // Webserver pages
  server.on("/",  HTTP_GET, [](AsyncWebServerRequest *request){
    request->send(SPIFFS, "/hasVIOLET_ALLINONE.html", "text/html");
    Serial.println("1400: GET /");
  });
    server.on("/css/hasVIOLET.css",  HTTP_GET, [](AsyncWebServerRequest *request){
    request->send(SPIFFS, "/hasVIOLET.css", "text/html");
    Serial.println("1400: GET /");
  });
    server.on("/js/hasVIOLET.js",  HTTP_GET, [](AsyncWebServerRequest *request){
    request->send(SPIFFS, "/hasVIOLET.js", "text/html");
    Serial.println("1400: GET /");
  });

  // attach filesystem root at URL /fs
  server.serveStatic("/fs", SPIFFS, "/");
  
  // Websocket Handler
  ws.onEvent(onWsEvent);
  server.addHandler(&ws);

  // Start Webserver
  server.begin();
  Serial.println("400: Webserver initialized...");
}
/// END OF SETUP FUNCTIONS

/// OLED DISPLAY FUNCTIONS
void logo(){
  Heltec.display->clear();
  Heltec.display->drawXbm(0,5,hvdnimg_width,hvdnimg_height,hvdnimg_bits);
  Heltec.display->display();
  delay(1500);
  Heltec.display->clear();
}

// Display myOLEDmsg on OLED
void OLEDme(String myOLEDmsg, int oledTIME)
{
  Heltec.display->clear();
  Heltec.display->setTextAlignment(TEXT_ALIGN_LEFT);
  Heltec.display->setFont(ArialMT_Plain_10);
  Heltec.display->drawString(0, 15, myOLEDmsg);
  Heltec.display->display();
  delay(oledTIME);
  Heltec.display->clear();
}
/// END OF OLED DISPLAY FUNCTIONS

/// SPIFFS FUNCTIONS
// Read HASVIOLET.CFG from SPIFFS
void getHASVCFG()                           
  {
    File hasvcfgREAD = SPIFFS.open("/hasviolet.cfg");
    if(!hasvcfgREAD){
      Serial.println("ERR: Opening HASVIOLET.CFG for read");
      return;
    }
    while (hasvcfgREAD.available()){
      mycall = hasvcfgREAD.readStringUntil('\n');               //mycall
      mycall.trim();
      myssid = hasvcfgREAD.readStringUntil('\n');               //myssid
      myssid.trim();
      dstcall = hasvcfgREAD.readStringUntil('\n');              //dstcall
      dstcall.trim();
      dstssid = hasvcfgREAD.readStringUntil('\n');              //dstssid
      dstssid.trim();
      String file_freq = hasvcfgREAD.readStringUntil('\n');     //frequency
      frequency = file_freq.toInt();
      String file_spread = hasvcfgREAD.readStringUntil('\n');   //spread
      spread = file_spread.toInt();
      String file_bw = hasvcfgREAD.readStringUntil('\n');       //bandwidth
      bandwidth = file_bw.toInt();
      String file_cr4 = hasvcfgREAD.readStringUntil('\n');      //codingrate4
      codingrate4 = file_cr4.toInt();
      String file_txpwr = hasvcfgREAD.readStringUntil('\n');    //txpwr
      txpwr = file_txpwr.toInt();
    }
    hasvcfgREAD.close();
    Serial.println("110: HASVIOLET.CFG read...");
  }

// Write HASVIOLET.CFG to SPIFFS in following order
